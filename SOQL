 Custom Relationships

Parent-to-Child

SELECT Id, Name, (SELECT Id, CustomField__c FROM CustomObjects__r)
    FROM ParentObject__c

Child-to-Parent:

SELECT Id, CustomField__c, ParentObject__r.Name
    FROM CustomObject__c

